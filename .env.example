# Looploop 环境变量配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API Key（必填）
LLM_API_KEY=sk-your-deepseek-key-here

# DeepSeek API 地址（默认值通常不需修改）
LLM_BASE_URL=https://api.deepseek.com

# 模型名称
# deepseek-chat: DeepSeek-V3 系列，适合复杂结构化输出
# deepseek-coder: 适合代码相关任务
LLM_MODEL=deepseek-chat

# 调试模式（开发时设为 true）
DEBUG=true
